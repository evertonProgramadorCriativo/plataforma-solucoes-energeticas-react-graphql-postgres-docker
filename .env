  
# EMAILJS (https://www.emailjs.com/)
 

# Service ID (Dashboard > Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# Template de confirmação (Dashboard > Email Templates)
VITE_EMAILJS_TEMPLATE_CONFIRMACAO=your_template_confirmacao_id_here

# Template interno (Dashboard > Email Templates)
VITE_EMAILJS_TEMPLATE_INTERNO=your_template_interno_id_here

# Public Key (Dashboard > Account > API Keys)
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
